# ===== Dashboard login (wajib) =====
# Password untuk masuk dashboard, minimal 8 karakter
DASHBOARD_PASSWORD=
# String acak minimal 32 karakter untuk menandatangani cookie login
SESSION_SECRET=

# ===== WhatsApp via Fonnte (default) =====
FONNTE_TOKEN=
# Nomor tujuan alert, format 628xxxx (pisahkan koma untuk beberapa nomor)
WA_TARGET=
# Opsional: fonnte | telegram | console (kosong = fonnte jika token ada, selain itu console)
NOTIFIER=

# ===== Telegram (opsional, pengganti WhatsApp) =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Penyimpanan =====
# file (default, untuk VPS/PC) atau firestore (wajib untuk Vercel)
STORE=
# Folder data untuk STORE=file (default ./data)
DATA_DIR=

# ===== Firestore (hanya jika STORE=firestore) =====
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ===== Jadwal via HTTP (Vercel / cron eksternal) =====
# Minimal 16 karakter; dikirim sebagai header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ===== Opsional =====
# Urutan sumber data Binance (default: data-api.binance.vision lalu api.binance.com)
BINANCE_BASE_URLS=
